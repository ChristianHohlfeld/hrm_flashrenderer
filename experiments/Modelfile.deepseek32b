FROM deepseek-r1:32b

# Force all layers onto GPU (0 = CPU only, 99 = all layers on GPU)
PARAMETER num_gpu 99

# Context window - 4096 is safe for 32b across 33GB VRAM
PARAMETER num_ctx 4096

# Temperature for DeepSeek-R1 reasoning (lower = more deterministic)
PARAMETER temperature 0.6

# Top-p sampling
PARAMETER top_p 0.95

SYSTEM """You are DeepSeek-R1, a powerful reasoning AI assistant. Think step by step before answering."""
