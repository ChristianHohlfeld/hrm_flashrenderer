[Unit]
Description=HRM-FlashRenderer HTTP Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hrm_flashrenderer
Environment=TORCH_CUDA_ARCH_LIST=7.5
Environment=HRM_FLASH_AUTHKEY=hrmflash
ExecStart=/usr/bin/env bash -lc 'hrm-flash serve --hrm_model /opt/hrm_flashrenderer/model --llm_model /opt/models/llm --world 2 --host 0.0.0.0 --port 8080 --local_files_only'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
