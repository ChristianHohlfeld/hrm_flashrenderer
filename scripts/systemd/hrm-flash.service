[Unit]
Description=HRM FlashRenderer Native DeepSeek Stack (3 backends + router)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hrm_flashrenderer
Environment=BACKEND=deepseek_int8
Environment=PREPARE_MODELS=1
Environment=STRICT_GPU_TOPOLOGY=1
Environment=LOCAL_FILES_ONLY=1
# Replace with your real HRM index path before enabling this unit.
Environment=HRM_MODEL_DIR=/opt/hrm_flashrenderer/model_index
ExecStart=/usr/bin/env bash -lc 'bash scripts/start_native_stack.sh "$HRM_MODEL_DIR" auto'
ExecStop=/usr/bin/env bash -lc 'bash scripts/stop_native_stack.sh'
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
